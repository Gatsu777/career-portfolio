---
const stats = [
  { label: "Années d'expérience", value: "20+" },
  { label: "Projets IT", value: "100+" },
  { label: "Technologies", value: "80+" },
  { label: "Domaines", value: "Infrastructure • Cloud • Cybersécurité" },
];
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <title>Nicolas ETIENNE - IT Career Portfolio</title>

    <style>
      :root{
        --bg:#0f172a;
        --card:#1e293b;
        --accent:#38bdf8;
        --text:#f8fafc;
        --muted:#94a3b8;
      }

      *{
        margin:0;
        padding:0;
        box-sizing:border-box;
      }

      body{
        background:var(--bg);
        color:var(--text);
        font-family:Segoe UI,Arial,sans-serif;
      }

      header{
        max-width:1200px;
        margin:auto;
        padding:70px 40px;
      }

      h1{
        font-size:58px;
      }

      h2{
        color:var(--accent);
        margin-top:10px;
        font-weight:400;
      }

      p{
        margin-top:30px;
        color:var(--muted);
        max-width:700px;
        line-height:1.6;
        font-size:18px;
      }

      .stats{
        display:grid;
        grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
        gap:20px;
        margin-top:60px;
      }

      .card{
        background:var(--card);
        border-radius:12px;
        padding:25px;
      }

      .value{
        font-size:34px;
        font-weight:bold;
        color:var(--accent);
      }

      .label{
        margin-top:10px;
        color:var(--muted);
      }

      .actions{
        margin-top:60px;
      }

      a.button{
        display:inline-block;
        background:var(--accent);
        color:#000;
        text-decoration:none;
        padding:14px 26px;
        border-radius:8px;
        font-weight:bold;
      }

      footer{
        margin-top:80px;
        padding:40px;
        text-align:center;
        color:var(--muted);
      }
    </style>
  </head>

  <body>

    <header>

      <h1>Nicolas ETIENNE</h1>

      <h2>Responsable des Systèmes d'Information</h2>

      <p>
        Pilotage des infrastructures IT, cybersécurité, cloud,
        virtualisation, réseaux, Microsoft 365 et transformation numérique.
      </p>

      <div class="stats">

        {stats.map((stat)=>(
          <div class="card">
            <div class="value">{stat.value}</div>
            <div class="label">{stat.label}</div>
          </div>
        ))}

      </div>

      <div class="actions">

        <a class="button" href="#">
          Découvrir mon parcours →
        </a>

      </div>

    </header>

    <footer>

      IT Career Portfolio • Version 0.1

    </footer>

  </body>

</html>