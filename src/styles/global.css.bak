:root{

    /* Couleurs principales */

    --bg:#0b1323;
    --surface:#18263b;

    /* Bleu */

    --primary:#3b82f6;
    --primary-dark:#2563eb;

    /* Jaune */

    --accent:#fbbf24;
    --accent-hover:#f59e0b;

    /* Texte */

    --text:#f8fafc;
    --muted:#9ca3af;

}


}

*{
margin:0;
padding:0;
box-sizing:border-box;
}

body{

background:var(--bg);

color:var(--text);

font-family:Segoe UI,Arial,sans-serif;

}

.navbar{

display:flex;

justify-content:space-between;

align-items:center;

padding:20px 60px;

background:#111827;

}

.navbar ul{

display:flex;

gap:25px;

list-style:none;

}

.navbar a{

text-decoration:none;

color:white;

}

.logo{

font-weight:bold;

color:var(--primary);

font-size:22px;

}

.footer{

text-align:center;

padding:40px;

color:var(--muted);

margin-top:80px;

}
.dashboard{

display:grid;

grid-template-columns:repeat(auto-fit,minmax(320px,1fr));

gap:24px;

padding:60px;

}

.panel{

background:var(--surface);

padding:28px;

border-radius:12px;

}

.panel h3{

margin-bottom:18px;

color:var(--accent);

}

.panel ul{

padding-left:20px;

line-height:1.9;

}

.skills{

display:flex;

flex-wrap:wrap;

gap:12px;

margin-top:20px;

}

.skills span{

background:#0f172a;

padding:10px 18px;

border-radius:25px;

color:var(--primary);

border:1px solid rgba(255,255,255,.08);

}
